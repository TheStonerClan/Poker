# Holdem Clock — environment variables
#
# Copy this file to .env.local for local dev. Set the same vars in
# Vercel project settings for production. NEVER commit .env.local.

# Supabase project URL (https://<project-ref>.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon (publishable) key — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service-role key — SERVER ONLY. Never expose to the client.
# Only used by route handlers / server actions that need to bypass RLS
# (e.g. inserting tournament_events from a webhook).
SUPABASE_SERVICE_ROLE_KEY=
